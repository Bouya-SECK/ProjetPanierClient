<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="sn.bouya.panierclient.Controller.PanierController"
            prefHeight="400.0" prefWidth="600.0">

    <children>

        <!-- Formulaire de modification -->
        <Pane layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="600.0"
              style="-fx-background-color: black;">
            <children>
                <Label layoutX="20.0" layoutY="25.0" text="Nom Complet" textFill="WHITE"/>
                <TextField fx:id="nomComplet" layoutX="130.0" layoutY="20.0" prefWidth="200.0"/>

                <Button onAction="#addPanier" layoutX="350.0" layoutY="20.0"
                        text="Ajouter"
                        style="-fx-background-color: green;" textFill="WHITE"/>

                <Button onAction="#modifierPanier" layoutX="420.0" layoutY="20.0"
                        text="Modifier"
                        style="-fx-background-color: orange;" textFill="WHITE"/>

                <Button onAction="#supprimerPanier" layoutX="495.0" layoutY="20.0"
                        text="Supprimer"
                        style="-fx-background-color: red;" textFill="WHITE"/>
            </children>
        </Pane>

        <!-- TableView -->
        <TableView fx:id="tablePanier" layoutX="0.0" layoutY="90.0"
                   prefHeight="310.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80.0"/>
                <TableColumn fx:id="colNomComplet" text="Nom Complet" prefWidth="300.0"/>
                <TableColumn fx:id="colDateCreation" text="Date Création" prefWidth="200.0"/>
            </columns>
        </TableView>

    </children>

</AnchorPane>