<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="sn.bouya.panierclient.Controller.PanierController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <Pane layoutX="111.0" layoutY="100.0" prefHeight="150.0" prefWidth="378.0"
              style="-fx-background-color: black;">
            <children>
                <Label layoutX="20.0" layoutY="30.0" text="Nom Complet" textFill="WHITE"/>
                <TextField fx:id="nomComplet" layoutX="150.0" layoutY="25.0" prefWidth="200.0"/>

                <Button onAction="#addPanier"
                        layoutX="150.0" layoutY="80.0"
                        text="Ajouter"
                        style="-fx-background-color: green;"
                        textFill="WHITE"/>
            </children>
        </Pane>
    </children>
</AnchorPane>